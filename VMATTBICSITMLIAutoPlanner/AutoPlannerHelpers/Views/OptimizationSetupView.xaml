<UserControl x:Class="AutoPlannerHelpers.Views.OptimizationSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoPlannerHelpers.Views"
             xmlns:enum="clr-namespace:AutoPlannerHelpers.Enums"
             mc:Ignorable="d">
    <Grid>
        <Border Margin="0" BorderThickness="1,0,0,0" BorderBrush="Black">
            <StackPanel Name="OPT" HorizontalAlignment="Center" Margin="0">
                <Label Content="Parámetros de optimización" FontSize="20" FontStyle="Normal" HorizontalAlignment="Center" VerticalAlignment="Top"></Label>
                <Grid Height="25" Width ="560" HorizontalAlignment="Center" Margin="0,5,0,6">
                    <Button Content="Agregar restricción" Width="100" HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding AddOptimizationConstraintCommand}"/>
                    <Button Content="Agregar predeterminados" Width="120" HorizontalAlignment="Center" VerticalAlignment="Top" Command="{Binding AddDefaultOptimizationConstraintsCommand}"/>
                    <Button Content="Borrar lista" Width="100" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding ClearOptimizationConstraintListCommand}"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="0.6*"/>
                        <ColumnDefinition Width="0.6*"/>
                        <ColumnDefinition Width="0.7*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Id estructura" Grid.Column="0" HorizontalAlignment="Center"/>
                    <Label Content="Tipo de restricción" Grid.Column="1" HorizontalAlignment="Center"/>
                    <Label Content="Volumen (%)" Grid.Column="2" HorizontalAlignment="Center"/>
                    <Label Content="Dosis (cGy)" Grid.Column="3" HorizontalAlignment="Center"/>
                    <Label Content="Prioridad" Grid.Column="4" HorizontalAlignment="Center"/>
                </Grid>
                <ScrollViewer Height="380" Width="585" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <ItemsControl x:Name="OptimizationConstraintsSP" ItemsSource="{Binding PlanOptimizationConstraints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Label Content="{Binding PlanId}" Margin="5" HorizontalAlignment="Center"/>
                                    <ItemsControl ItemsSource="{Binding OptimizationConstraints}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="0.8*"/>
                                                        <ColumnDefinition Width="0.6*"/>
                                                        <ColumnDefinition Width="0.6*"/>
                                                        <ColumnDefinition Width="0.7*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox Grid.Column="0" HorizontalContentAlignment="Center" ItemsSource="{Binding Path=DataContext.StructureIds, ElementName=OptimizationConstraintsSP}" SelectedItem="{Binding StructureId}" Margin="1"/>
                                                    <ComboBox Grid.Column="1" HorizontalContentAlignment="Center" SelectedItem="{Binding ConstraintType}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type enum:OptimizationObjectiveType}}}" Margin="1"/>
                                                    <TextBox Grid.Column="2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="{Binding QueryVolume}" Margin="1"/>
                                                    <TextBox Grid.Column="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="{Binding QueryDose}" Margin="1"/>
                                                    <TextBox Grid.Column="4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="{Binding Priority}" Margin="1"/>
                                                    <Button Content="Borrar" Grid.Column="5" Command="{Binding Path=DataContext.ClearRowCommand, ElementName=OptimizationConstraintsSP}" CommandParameter="{Binding}" Width="90" Margin="1"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Content="Asignar restricciones de optimización" FontWeight="Bold" Width="190" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10,0,0" Command="{Binding AssignOptimizationConstraintsCommand}"></Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
