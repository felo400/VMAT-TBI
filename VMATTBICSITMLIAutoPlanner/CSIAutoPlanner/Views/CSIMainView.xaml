<Window x:Class="CSIAutoPlanner.Views.CSIMainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CSIAutoPlanner.Views"
        xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
        mc:Ignorable="d"
        Title="Autoplanificación VMAT CSI" 
        SizeToContent="WidthAndHeight"
        SizeChanged="Window_SizeChanged"
        WindowStartupLocation="CenterScreen">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding WindowClosingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Width="Auto">
        <StackPanel>
            <Grid>
                <Label Content="Autoplanificación VMAT CSI" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Top"/>
                <Button Content="Ayuda" HorizontalAlignment="Right" Margin="0,10,30,0" VerticalAlignment="Top" Width="75" Command="{Binding HelpGuideCommand}"/>
                <Button x:Name="quickStart" Content="Inicio rápido" HorizontalAlignment="Left" Margin="30,10,0,0" VerticalAlignment="Top" Width="75" Command="{Binding QuickStartGuideCommand}"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.ColumnSpan="2" Grid.Row="0" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Label Content="Historia (MRN):" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right" Margin="0" VerticalAlignment="Center"/>
                    <Label Content="{Binding PatientMRN}" Grid.Column="1" Grid.Row="0" FontWeight="Bold" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Center"/>

                    <Label Content="Structure set:" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <Label Content="{Binding StructureSetId}" Grid.Column="1" Grid.Row="1" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Width="140"/>
                </Grid>

                <Grid Grid.Column="0" Grid.Row="2" Grid.RowSpan="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <Label Content="Plantillas" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"></Label>
                    <ListBox ItemsSource="{Binding PlanTemplates}" SelectedItem="{Binding SelectedTemplate}" Grid.Row="1" Width="300" HorizontalContentAlignment="Center" DisplayMemberPath="TemplateName"/>
                </Grid>


                <Grid Grid.Column="1" Grid.Row="2" Grid.RowSpan="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Rx plan base" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                    <Label Content="Rx plan boost" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>

                    <Label Content="Dosis por fracción (cGy/fx):" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"></Label>
                    <Label Content="Número de fracciones:" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"></Label>
                    <Label Content="Dosis Rx (cGy):" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"></Label>

                    <TextBox Text="{Binding InitialDosePerFraction}"  Grid.Row="1" Grid.Column="1" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Width="75"></TextBox>
                    <TextBox Text="{Binding InitialNumberOfFractions}" Grid.Row="2" Grid.Column="1" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Width="75"></TextBox>
                    <TextBox Text="{Binding InitialPlanTotalDose}" Grid.Row="3" Grid.Column="1" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Width="75" IsReadOnly="True"></TextBox>

                    <TextBox Text="{Binding BoostDosePerFraction}"  Grid.Row="1" Grid.Column="2" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Width="75"></TextBox>
                    <TextBox Text="{Binding BoostNumberOfFractions}" Grid.Row="2" Grid.Column="2" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Width="75"></TextBox>
                    <TextBox Text="{Binding BoostPlanTotalDose}" Grid.Row="3" Grid.Column="2" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Width="75" IsReadOnly="True"></TextBox>
                </Grid>
            </Grid>

            <Grid Background="#B3E5FC">
                <TabControl Style="{StaticResource LeftEqualHeaderTabControlStyle}">
                    <!-- Export/Import (auto-contorneo externo de Stanford) oculto: no se usa en este servicio. Para reactivarlo quite Visibility="Collapsed" -->
                    <TabItem Header="Exportar/Importar" BorderThickness="0,1,1,0" Visibility="Collapsed">
                        <TabControl Style="{StaticResource TopEqualHeaderTabControlStyle}">
                            <TabItem Header="Exportar CT" Content="{Binding ExportCT}" BorderThickness="1,1,1,1">
                            </TabItem>
                            <TabItem Header="Importar structure set" Content="{Binding ImportSS}" BorderThickness="1,1,1,1"/>
                        </TabControl>
                    </TabItem>
                    <TabItem Header="Definir targets" IsSelected="True" BorderThickness="0,1,1,0" Background="{Binding SpecifyTargetsTabBackground, FallbackValue=#FFE082}">
                        <TabControl Style="{StaticResource TopEqualHeaderTabControlStyle}">
                            <TabItem Content="{Binding TargetStructureDerivations}" Background="{Binding TargetStructureDerivationsBackground, FallbackValue=#FFE082}" Header="Derivar targets" BorderThickness="1,1,1,1">
                            </TabItem>
                            <TabItem Header="Asignar targets" BorderThickness="0,1,1,1" Content="{Binding SpecifyTargets}" Background="{Binding SetTargetsTabBackground, FallbackValue=#FFE082}">
                            </TabItem>
                        </TabControl>
                    </TabItem>
                    <TabItem Header="Estructuras OPT" Background="{Binding StructureTuningTabBackground, FallbackValue=#FFE082}" BorderThickness="0,1,1,0">
                        <TabControl Style="{StaticResource TopEqualHeaderTabControlStyle}">
                            <TabItem Header="Estructuras especiales" Content="{Binding SpecialOptimizationStructures}" BorderThickness="1,1,1,1" >
                            </TabItem>
                            <TabItem Header="Generar anillos" Content="{Binding RingGeneration}" BorderThickness="0,1,1,1">
                            </TabItem>
                            <TabItem Header="Recorte/solapamiento" Content="{Binding StructureCropOverlap}" BorderThickness="0,1,1,1">
                            </TabItem>
                            <TabItem Header="Derivaciones" Content="{Binding OptimizationStructureDerivations}" Background="{Binding OptimizationStructureDerivationBackground, FallbackValue=#FFE082}"  BorderThickness="0,1,1,1">
                            </TabItem>
                        </TabControl>
                    </TabItem>
                    <TabItem Header="Campos" Content="{Binding BeamPlacement}" Background="{Binding BeamPlacementTabBackground, FallbackValue=#FFE082}" BorderThickness="0,1,1,0">
                    </TabItem>
                    <TabItem Header="Configurar optimización" Content="{Binding OptimizationSetup}" Background="{Binding OptimizationSetupTabBackground, FallbackValue=#FFE082}" BorderThickness="0,1,1,0">
                    </TabItem>
                    <TabItem Header="Preparación del plan" Content="{Binding PlanPreparation}" BorderThickness="0,1,1,1">
                    </TabItem>
                    <TabItem Header="Configuración" Content="{Binding ScriptConfiguration}" BorderThickness="0,1,1,1">
                    </TabItem>
                </TabControl>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
