<Window x:Class="AutoPlannerOptimizationLoop.Prompts.SelectPatient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoPlannerOptimizationLoop.Prompts"
        mc:Ignorable="d"
                Title="Seleccionar paciente" WindowStartupLocation="CenterScreen" SizeToContent="WidthAndHeight" Background="#B3E5FC">
    <Grid>
        <StackPanel>
            <Grid VerticalAlignment="Top" Background="White" Height="Auto">
                <StackPanel>
                    <Label Content="Entrada manual" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                    <Grid Margin="10,0,10,10" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Historia (MRN):" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"></Label>
                        <TextBox x:Name="MRNTB" Height="22" Width="120" Grid.Column="1" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0"></TextBox>
                    </Grid>
                </StackPanel>
            </Grid>
            <Grid VerticalAlignment="Bottom" Height="Auto">
                <StackPanel>
                    <Label Content="Seleccionar paciente desde registros" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5"/>
                    <ListBox x:Name="mrnList" Grid.Column="0" Grid.Row="1" ItemsSource="{Binding PatientMRNs}" HorizontalContentAlignment="Center" Height="300" Width="160" Margin="10,0,10,10" SelectionChanged="mrnList_SelectionChanged"/>
                    <Grid>
                    </Grid>
                    <Button Content="Abrir paciente" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="100" Margin="0,0,0,5" Click="OpenPatient_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
