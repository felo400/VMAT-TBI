<Window x:Class="AutoPlannerOptimizationLoop.Views.OptimizationLoopMainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoPlannerOptimizationLoop.Views"
        mc:Ignorable="d" 
        Title="Optimización automática"
        Background="White"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">
    <!--region resources-->
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFE082"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <!--Scrollbar Thumbs-->
        <Style x:Key="ScrollThumbs" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid x:Name="Grid">
                            <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" Height="Auto" Fill="Transparent"/>
                            <Border x:Name="Rectangle1" CornerRadius="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" Height="Auto" Background="{TemplateBinding Background}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Horizontal">
                                <Setter TargetName="Rectangle1" Property="Width" Value="Auto"/>
                                <Setter TargetName="Rectangle1" Property="Height" Value="7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--ScrollBars-->
        <Style x:Key="ScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Foreground" Value="GhostWhite"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="GridRoot" Width="8" Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0.00001*"/>
                            </Grid.RowDefinitions>

                            <Track x:Name="PART_Track" Grid.Row="0" IsDirectionReversed="true" Focusable="false">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="{TemplateBinding Foreground}" Style="{StaticResource ScrollThumbs}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PageUp" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PageDown" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="Thumb" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="GridRoot" Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="PART_Track" Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="8"/>
                                <Setter TargetName="Thumb" Property="Tag" Value="Horizontal"/>
                                <Setter TargetName="PageDown" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                                <Setter TargetName="PageUp" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollViewer -->
        <Style x:Key="ScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition />
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.ColumnSpan="3" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="2" Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Style="{DynamicResource ScrollBarStyle}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="PART_Border" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="Black" Margin="0,0,0,0" CornerRadius="2,2,0,0" Padding="5,1,5,1">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" Margin="5" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFE082"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="TextElement.FontWeight" TargetName="ContentSite" Value="Bold"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="false">
                                <Setter Property="Background" Value="#FFE082"/>
                                <Setter Property="Foreground" Value="Black"/>

                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!--#endregion-->
    <Viewbox Stretch="None">
        <Grid>
            <StackPanel>
                <Grid VerticalAlignment="Top" Margin="0">
                    <Grid.Background>
                        <ImageBrush ImageSource="../Images/StanfordMedicine1.png" Stretch="Uniform" AlignmentY="Top" Opacity="0.25">
                            <ImageBrush.Transform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform Y="20" X="30"/>
                                </TransformGroup>
                            </ImageBrush.Transform>
                        </ImageBrush>
                    </Grid.Background>

                    <StackPanel>
                        <Grid Margin="0,5,0,10">
                            <Label Content="Ciclo de optimización VMAT" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" FontWeight="Bold" Margin="0,0,0,0"></Label>
                            <Button x:Name="help" Height="20" Width="75" HorizontalAlignment="Right" VerticalAlignment="Top" Content="Ayuda" Margin="0,7,20,0" Command="{Binding DocumentationCommand}"></Button>
                            <Button x:Name="quickStart" Height="20" Width="75" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Inicio rápido" Margin="20,7,0,0" Command="{Binding QuickStartCommand}"></Button>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="370"/>
                                <ColumnDefinition Width="400"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button Content="Seleccionar paciente" Grid.Column="0" Grid.Row="0" FontWeight="Bold" Width="125" Height="22" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding SelectPatientCommand}"></Button>
                            <Grid Grid.Column="0" Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Historia (MRN):" Grid.Column="0" Grid.Row="0" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" ></Label>
                                <Label Content="{Binding MRN,FallbackValue=mrn}" Grid.Column="1" Grid.Row="0" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" ></Label>
                            </Grid>
                            <Grid Grid.Column="0" Grid.Row="2" Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Tipo de plan:" Grid.Column="0" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" ></Label>
                                <Label Content="{Binding SelectedPlanType, FallbackValue=type}" Grid.Column="1" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" ></Label>
                            </Grid>
                            <Grid Margin="0" Grid.Column="0" Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Id plan base:" Grid.Column="0" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" ></Label>
                                <ComboBox ItemsSource="{Binding AvailableBasePlansForOptimization}" SelectedItem="{Binding SelectedBasePlanId}" Grid.Column="1" Width="120" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"></ComboBox>
                            </Grid>
                            <Grid Margin="0" Grid.Column="0" Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Id plan boost:" Grid.Column="0" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" ></Label>
                                <ComboBox ItemsSource="{Binding AvailableBoostPlansForOptimization}" SelectedItem="{Binding SelectedBoostPlanId}" Grid.Column="1" Width="120" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalAlignment="Center"></ComboBox>
                            </Grid>
                            <Label Content="Plantillas" Grid.Column="0" Grid.Row="5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"></Label>
                            <ListBox Grid.Column="0" Grid.Row="6" ItemsSource="{Binding PlanTemplates}" DisplayMemberPath="TemplateName" SelectedItem="{Binding SelectedTemplate}" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Height="100" Width="300" Margin="0,0,0,5"/>

                            <Grid Grid.Column="1" Grid.RowSpan="7" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.75*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Label Content="Plan base:" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"></Label>
                                <Label Content="Plan boost:" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"></Label>

                                <Label Content="Dosis por fracción (cGy/fx):" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"></Label>
                                <TextBox Text="{Binding BasePlanDosePerFraction}" Grid.Column="1" Grid.Row="1" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Width="75" Height="20" Margin="0" IsReadOnly="True"></TextBox>
                                <TextBox Text="{Binding BoostPlanDosePerFraction}" Grid.Column="2" Grid.Row="1" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Width="75" Height="20" Margin="0" IsReadOnly="True"></TextBox>

                                <Label Content="Número de fracciones:" Grid.Column="0" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/>
                                <TextBox Text="{Binding BasePlanNumberOfFractions}" Grid.Column="1" Grid.Row="2" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"  Width="75" Height="20" Margin="0" IsReadOnly="True"></TextBox>
                                <TextBox Text="{Binding BoostPlanNumberOfFractions}" Grid.Column="2" Grid.Row="2" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"  Width="75" Height="20" Margin="0" IsReadOnly="True"></TextBox>

                                <Label Content="Dosis Rx (cGy):" Grid.Column="0" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"></Label>
                                <TextBox Text="{Binding BasePlanTotalDose}" Grid.Column="1" Grid.Row="3" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Width="75" Height="20" Margin="0" IsReadOnly="True"></TextBox>
                                <TextBox Text="{Binding BoostPlanTotalDose}" Grid.Column="2" Grid.Row="3" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Width="75" Height="20" Margin="0" IsReadOnly="True"></TextBox>

                                <Label Content="Volúmenes de normalización:" Grid.Column="0" Grid.Row="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"></Label>
                                <ComboBox ItemsSource="{Binding AvailableBasePlanNormalizationVolumes}" SelectedItem="{Binding BasePlanNormalizationVolume}" Grid.Column="1" Grid.Row="4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="20" Margin="0" IsReadOnly="True" IsTabStop="False" ToolTip="{Binding BasePlanNormalizationVolume}"></ComboBox>
                                <ComboBox ItemsSource="{Binding AvailableBoostPlanNormalizationVolumes}" SelectedItem="{Binding BoostPlanNormalizationVolume}" Grid.Column="2" Grid.Row="4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="20" Margin="0" IsReadOnly="True" IsTabStop="False" ></ComboBox>

                                <Label Content="Verificar cobertura:" Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="5" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"></Label>
                                <CheckBox IsChecked="{Binding RunCoverageCheck}" Grid.Column="2" Grid.Row="5" Margin="7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                <Label Content="Copiar y guardar cada plan optimizado:" Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="6" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"></Label>
                                <CheckBox IsChecked="{Binding CopyAndSaveEachPlan}" Grid.Column="2" Grid.Row="6" Margin="7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                <Label Content="Máx. número de optimizaciones:" Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="7" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"></Label>
                                <TextBox Text="{Binding MaxNumberOfIterations}" Grid.Column="2" Grid.Row="7" Margin="0" Height="20" Width="75" HorizontalAlignment="Left" TextAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" ></TextBox>

                                <Label Content="Optimización extra para bajar puntos calientes:" Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="8" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"></Label>
                                <CheckBox IsChecked="{Binding RunOneAdditionalOptimization}" Grid.Column="2" Grid.Row="8" Margin="7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                <Label Content="PTV V100% (en %):" Grid.Column="0" Grid.Row="9" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"></Label>
                                <TextBox Text="{Binding PlanNormalizationValue}" Grid.Column="1" Grid.Row="9" Height="20" Width="75" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0"></TextBox>
                                <Button Grid.Column="2" Grid.Row="9" Content="?" Height="22" Width="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,0,0" Command="{Binding ShowPlanNormalizationInfoCommand}"></Button>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Grid>
                <Grid Background="#B3E5FC" VerticalAlignment="Bottom" Margin="0">
                    <TabControl Background="#B3E5FC" HorizontalAlignment="Left" TabStripPlacement="Left" Margin="0">
                        <TabItem Header="Objetivos del plan" Content="{Binding PlanObjectives}" BorderThickness="0,1,1,0"/>
                        <TabItem Header="Configurar optimización" Content="{Binding OptimizationSetup}" BorderThickness="0,1,1,1"/>
                        <TabItem Header="Configuración" Content="{Binding ScriptConfiguration}" VerticalAlignment="Bottom" BorderThickness="0,1,1,1" Margin="0"/>
                    </TabControl>
                </Grid>
            </StackPanel>
        </Grid>
    </Viewbox>
</Window>
